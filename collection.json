{
  "name": "bug-reports",
  "display_name": "Bug Reports",
  "version": "1.3.0",
  "description": "Bug reporting workflow — any member can submit and update their own bugs, org admins can review, triage, and forward selected reports to the agent-index log collection server. v1.3.0: non-admin write access — report-bug uses collision-free IDs and no longer writes the manifest; new update-bug task lets members revise their own bugs (ownership-enforced); collaborative-acls.json declares the all@ writer grant on bugs/ (+ config/ restriction) provisioned at install via install-collection Step 5.5 (closes bug 20260531-8d20ea22). v1.2.0: view-bugs always reconciles bug-manifest.json from individual bug files on read (closes bug 20260513-8d20ea22). v1.1.x: original bug-report + view-bugs + forward-bug skill set.",
  "author": "agent-index",
  "license": "open",
  "category": "developer-tools",
  "agent_index_min_version": "3.0.0",
  "api": [
    {
      "name": "report-bug",
      "triggers": [
        {
          "phrase": "report a bug",
          "capability": "report-bug",
          "description": "Submit a new bug report"
        },
        {
          "phrase": "found a bug",
          "capability": "report-bug",
          "description": "Log a bug you discovered"
        },
        {
          "phrase": "log a bug",
          "capability": "report-bug",
          "description": "Record a bug for tracking"
        },
        {
          "phrase": "something is broken",
          "capability": "report-bug",
          "description": "Report an issue or malfunction"
        }
      ]
    },
    {
      "name": "update-bug",
      "triggers": [
        {
          "phrase": "update my bug",
          "capability": "update-bug",
          "description": "Add detail to or revise a bug you reported"
        },
        {
          "phrase": "add detail to my bug report",
          "capability": "update-bug",
          "description": "Append more information to your bug"
        },
        {
          "phrase": "my bug is still happening",
          "capability": "update-bug",
          "description": "Confirm a bug you filed is still occurring"
        }
      ]
    },
    {
      "name": "view-bugs",
      "triggers": [
        {
          "phrase": "what bugs do we have",
          "capability": "view-bugs",
          "description": "View the current bug list"
        },
        {
          "phrase": "show bugs",
          "capability": "view-bugs",
          "description": "Display reported bugs"
        },
        {
          "phrase": "open bugs",
          "capability": "view-bugs",
          "description": "List unresolved bug reports"
        },
        {
          "phrase": "bug list",
          "capability": "view-bugs",
          "description": "Show all tracked bugs"
        }
      ]
    },
    {
      "name": "forward-bug",
      "triggers": [
        {
          "phrase": "forward this bug",
          "capability": "forward-bug",
          "description": "Send a bug report to the log collection server"
        },
        {
          "phrase": "submit bug to agent-index",
          "capability": "forward-bug",
          "description": "Forward a bug report upstream"
        }
      ]
    },
    {
      "name": "bug-reports-tutorial",
      "triggers": [
        {
          "phrase": "how do bug reports work",
          "capability": "bug-reports-tutorial",
          "description": "Learn how to use the bug reporting system"
        }
      ]
    }
  ],
  "provides": [
    {
      "capability": "bug-reporting",
      "capability_version": "1.0.0",
      "operations": {
        "report-bug": {
          "implemented_by": "report-bug",
          "type": "task"
        },
        "update-bug": {
          "implemented_by": "update-bug",
          "type": "task"
        },
        "view-bugs": {
          "implemented_by": "view-bugs",
          "type": "skill"
        },
        "forward-bug": {
          "implemented_by": "forward-bug",
          "type": "task"
        }
      }
    }
  ],
  "dependencies": [],
  "external_dependencies": [
    {
      "system": "Remote filesystem access",
      "access_required": "Read/write access to /shared/bug-reports/ for shared bug log storage via aifs_* tools",
      "contact": "org admin",
      "required": true
    }
  ],
  "eol_date": null,
  "marketplace_url": "https://github.com/agent-index/agent-index-marketplace-bug-reports",
  "support_url": "https://agent-index.ai/support"
}
